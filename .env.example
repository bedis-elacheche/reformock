NODE_ENV=development

HOST=0.0.0.0
PORT=3000
API_PREFIX=/v1
MAX_FILE_MB=10
MAX_UPLOAD_FILES=10

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
# Compteur de débit partagé via Redis (décommenter) ; sinon compteur en mémoire, par instance
# REDIS_URL=redis://localhost:6379
RATE_LIMIT_REDIS_NAMESPACE=reformock:rate-limit:
RATE_LIMIT_REDIS_REQUIRED=false

AUTH_DISABLED=false
OAUTH_CLIENT_ID=test-client
OAUTH_CLIENT_SECRET=test-secret
OAUTH_USERNAME=test-user
OAUTH_PASSWORD=test-password
TOKEN_TTL_SECONDS=3600

SEED_COUNT=20
GENERATION_INTERVAL_SECONDS=60
LIFECYCLE_DELAY_SECONDS=15

MAX_FLOWS=1000
MAX_STORE_MB=384

MAX_WEBHOOKS=50
WEBHOOK_ALLOW_PRIVATE=false
